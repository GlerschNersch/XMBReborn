<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: the same as backup_rules.xml, for cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="xmb.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="xmb.xml" />
    </device-transfer>
</data-extraction-rules>
